// along with this program. If not, see <https://www.gnu.org/licenses/>.

#ifndef WXL_HOOK_POINT
#error "define WXL_HOOK_POINT(name, address, signature) before including Points.def"
#endif

// Loads the world around a position, with the loading screen when show_loading is nonzero.
// Called with 1 from the movement update that follows a login or a teleport, with 0 for the
// preloads around a cinematic camera, a far-sight target or a transport leg. On return the
// terrain and objects around the position are resident.
WXL_HOOK_POINT("World.Preload", WXL_SITE("World::Preload", 0),
               "void __cdecl (const wxl_vec3* position, int32_t show_loading)")

// Switches the loaded map: repoints the map globals, purges the loaded tiles, loads the new
// map's tables and writes the id. Runs before World.Preload on a map change.
WXL_HOOK_POINT("Map.Load", WXL_SITE("CMap::Load", 0),
               "void __cdecl (const char* map_name, int32_t map_id)")
