//
// The hook points core names: one row per point, included with
// WXL_HOOK_POINT(name, address, signature) defined by the expander.
//
// A name is part of what mods attach by: it may be added, never renamed or dropped. The address
// is resolved through site.hpp, so an upstream rename fails the build rather than drifting. The
// signature is text a human checks a detour against; the runtime does not interpret it. Only
// function entries belong here: patch sites and data globals are not detour targets.
//
// The seams of include/wxl/seams/ are named points too (World.Preload is one) and are listed
// ahead of these rows by Points.cpp; a function that has a seam is not repeated here.

#ifndef WXL_HOOK_POINT
#error "define WXL_HOOK_POINT(name, address, signature) before including Points.def"
#endif

// Switches the loaded map: repoints the map globals, purges the loaded tiles, loads the new
// map's tables and writes the id. Runs before World.Preload on a map change.
WXL_HOOK_POINT("Map.Load", WXL_SITE("CMap::Load", 0), "void __cdecl (const char* map_name, int32_t map_id)")
