# Writes the header that names the commits a build of WarcraftXL.dll comes from, run as a script
# at every build (cmake -P):
#
#   -DOUT=<header> -DCORE=<core checkout> -DSDK=<sdk checkout> [-DCLIENT=<client checkout>]
#
# Each id is "<branch>@<short commit>", "+dirty" when tracked files differ from the commit (line
# endings aside), "unknown" outside a git checkout. The header is rewritten only when an id moved,
# so an unchanged tree recompiles nothing.

find_package(Git QUIET)

function(wxl_build_id dir out)
    if(NOT dir OR NOT GIT_EXECUTABLE)
        set(${out} "unknown" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse --short=9 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed ERROR_QUIET)
    if(failed)
        set(${out} "unknown" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse --abbrev-ref HEAD
                    OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" -c core.autocrlf=true status --porcelain
                            --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(id "${branch}@${commit}")
    if(changes)
        string(APPEND id "+dirty")
    endif()
    set(${out} "${id}" PARENT_SCOPE)
endfunction()

wxl_build_id("${CORE}" core)
wxl_build_id("${SDK}" sdk)
if(CLIENT)
    wxl_build_id("${CLIENT}" client)
else()
    set(client "")
endif()

set(text "// Generated by cmake/build_ids.cmake at build time, not by hand.\n"
         "#pragma once\n"
         "#define WXL_BUILD_ID_CORE \"${core}\"\n"
         "#define WXL_BUILD_ID_SDK \"${sdk}\"\n"
         "#define WXL_BUILD_ID_CLIENT \"${client}\"\n")
string(CONCAT text ${text})
if(EXISTS "${OUT}")
    file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
