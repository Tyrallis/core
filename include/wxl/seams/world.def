// The World domain: seams on the functions that load and unload the world.

#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including world.def"
#endif

// Loads the world around a position, with the loading screen when show_loading is nonzero.
// Called with 1 from the movement update that follows a login or a teleport, with 0 for the
// preloads around a cinematic camera, a far-sight target or a game object. The map id is already
// the destination's when the call starts: CMap::Load ran before it. On return the terrain and
// objects around the position are resident. Before raises WorldLeave and After raises
// WorldEnter, both only when show_loading is nonzero.
WXL_SEAM(World, Preload, "World::Preload", void, cdecl, (const wxl_vec3* position, int32_t show_loading))
WXL_SEAM_RAISES(World, Preload, WorldLeave)
WXL_SEAM_RAISES(World, Preload, WorldEnter)
