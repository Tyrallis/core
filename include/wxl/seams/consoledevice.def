#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including consoledevice.def"
#endif

// Creates the graphics device: picks the API and retries CreateGxDevice until one is made. Its one
// caller is InitializeGlobal, once, at process start (0x00406B28). It returns only with a device:
// every failure -- no device to be had, or one without two texture units -- shows a message and
// ends the process (exit(0)). After announces WXL_STAGE_GRAPHICS, and checks the device is there
// all the same rather than trusting that.
//
// That is the only honest place for the stage. InitializeGlobal reads its first client database
// (Startup_Strings.dbc, through SFile::OpenEx) just before calling this, so storage is always up
// first; InitializeClient creates the script context (FrameScript_Initialize) only after, and the
// screen's paint is registered later still -- so the first frame the client draws comes after
// script, and could never announce a stage that precedes it.
//
// It reads only its title; the two flags are on the stack all the same, pushed and cleaned by
// its caller (`push 1; push 1; push title; call; add esp, 0xc`), which is why the row declares
// them.
WXL_SEAM(ConsoleDevice, Initialize, "ConsoleDeviceInitialize", void, cdecl, (const char* title, bool unused_a2, bool unused_a3))
