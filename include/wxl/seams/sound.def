#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including sound.def"
#endif

// Starts a sound kit. The client gives this name to two functions -- one taking a kit id, one
// taking a kit name -- and the second ends by calling the first, so this row covers both: a
// sound named by path arrives here with the id its name resolved to. That is why the SoundPlay
// it raises carries an id and an empty path, which the contract allows and which is the whole
// truth at this point. The symbol carries the address because the name alone is ambiguous.
//
// A class static, so it has external linkage and carries the convention it is declared with,
// which is the default: cdecl.
//
// Gated, because the contract lets a handler of SoundPlay write WXL_TRUE through
// wxl_sound_args::suppressed and expect the sound not to play. Taking the call answers 17,
// which is what the client itself answers when sound is off.
WXL_SEAM_GATE(Sound, PlaySoundKit, "SI2::PlaySoundKit@0x004C6A40", int32_t, cdecl, (int32_t sound_kit_id, const void* position, void* object, void* properties, uint32_t advanced_id, uint32_t* sound_id, int32_t check_distance, int32_t keep_playing))
WXL_SEAM_RAISES(Sound, PlaySoundKit, SoundPlay)
