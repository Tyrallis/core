#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including input.def"
#endif

// The client's window procedure: keyboard, mouse, focus, resize, and everything else Windows
// sends it. A free function with external linkage, declared in Engine/Source/Os/Input.h and
// installed as the window class's procedure, so its convention is the platform's default.
//
// Gated, because the contract lets a handler of Input write WXL_TRUE through
// wxl_input_args::handled and expect the client not to see the message. Taking the call
// answers 0, which is what a window procedure answers for a message it handled itself; that is
// right for the messages a mod has any business swallowing -- keys, characters, mouse buttons
// -- and wrong for the few that want a different value, so a handler that swallows one of
// those is answering for the client and had better know it.
//
// The x64 call site is in Engine/Source/Os/Win64/Input.cpp. Its Win32 twin is left alone: that
// configuration is the layout reference and carries no runtime, and the stock 32-bit client
// reaches this function by detour, not by call site.
WXL_SEAM_GATE(Input, WindowProc, "OsWindowProc", intptr_t, cdecl, (void* window, uint32_t message, uintptr_t wparam, intptr_t lparam))
WXL_SEAM_RAISES(Input, WindowProc, Input)
