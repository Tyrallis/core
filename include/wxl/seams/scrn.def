// The Scrn domain: seams on the screen's paint, which drives every frame the client draws.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including scrn.def"
#endif

// The EVENT_ID_PAINT handler of Layer.cpp: one call is one frame. When the device has a context
// and the window can be seen, it walks the layers in z-order -- the world and the interface are
// two of them -- has each paint, and presents; otherwise it presents what is there and sleeps.
//
// Before raises FrameBegin only on the branch that draws, decided by the function's own two
// tests, GxHasContext (inlined at 0x004A8723) and GxIsWindowVisible: a minimised client draws no
// frame. After raises nothing; the frame ends at the present, in Gx.ScenePresent.
//
// A static of Layer.cpp whose address is taken (it is registered as an event handler), so it
// keeps its declared convention. It never reads its two parameters; its callers push and clean
// them (0x004A8BA4 pushes both and cleans eight bytes), so the row declares them.
WXL_SEAM_BEFORE(Scrn, OnPaint, "OnPaint", int32_t, cdecl, (const void* data, void* param))
WXL_SEAM_RAISES(Scrn, OnPaint, FrameBegin)
