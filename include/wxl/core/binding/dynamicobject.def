// The DynamicObject domain of the client binding: the area-effect descriptor block (CGDynamicObjectData).
//
// The rows read through CGDynamicObject_C::m_dynamicObject.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including dynamicobject.def"
#endif

WXL_BINDING_FIELD_VIA(dynamic_caster, uint64_t, CGDynamicObject_C, m_dynamicObject, CGDynamicObjectData, m_caster, 0)
WXL_BINDING_FIELD_VIA(dynamic_spell_id, uint32_t, CGDynamicObject_C, m_dynamicObject, CGDynamicObjectData, m_spellID, 0)
WXL_BINDING_FIELD_VIA(dynamic_radius, float, CGDynamicObject_C, m_dynamicObject, CGDynamicObjectData, m_radius, 0.0f)
WXL_BINDING_FIELD_VIA(dynamic_cast_time, uint32_t, CGDynamicObject_C, m_dynamicObject, CGDynamicObjectData, m_castTime, 0)
