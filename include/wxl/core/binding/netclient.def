#ifndef WXL_BINDING_FIELD
#error "define WXL_BINDING_FIELD(name, ret, Type, member, absent) before including netclient.def"
#endif

// The buffer the message lives in, null when the store holds nothing.
WXL_BINDING_FIELD(message_data, const void*, CDataStore, m_data, 0)

// One past the last byte of the message, as an offset into that buffer.
WXL_BINDING_FIELD(message_size, uint32_t, CDataStore, m_size, 0)

// The read cursor: where the message starts for whoever is about to read it. A store that has
// been reset carries 0xFFFFFFFF here, which is past m_size and says there is nothing to read.
WXL_BINDING_FIELD(message_read, uint32_t, CDataStore, m_read, 0)
