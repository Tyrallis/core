#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including binding.def"
#endif

#ifndef WXL_BINDING_FIELD
    #define WXL_BINDING_FIELD(name, ret, Type, member, absent) \
        WXL_BINDING(name, ret, (const void* object), (object), absent)
    #define WXL_BINDING_FIELD_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA
    #define WXL_BINDING_FIELD_VIA(name, ret, Type, via, ViaType, member, absent) \
        WXL_BINDING(name, ret, (const void* object), (object), absent)
    #define WXL_BINDING_FIELD_VIA_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA_INDEX
    #define WXL_BINDING_FIELD_VIA_INDEX(name, ret, Type, via, ViaType, member) \
        WXL_BINDING(name, wxl_bool, (const void* object, uint32_t index, ret* out), (object, index, out), WXL_FALSE)
    #define WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA_AT
    #define WXL_BINDING_FIELD_VIA_AT(name, ret, Type, via, ViaType, member, Elem, elem_member) \
        WXL_BINDING(name, wxl_bool, (const void* object, uint32_t index, ret* out), (object, index, out), WXL_FALSE)
    #define WXL_BINDING_FIELD_VIA_AT_DEFAULTED
#endif

#include "wxl/core/binding/world.def"
#include "wxl/core/binding/objectmgr.def"
#include "wxl/core/binding/object.def"
#include "wxl/core/binding/unit.def"
#include "wxl/core/binding/player.def"
#include "wxl/core/binding/item.def"
#include "wxl/core/binding/container.def"
#include "wxl/core/binding/gameobject.def"
#include "wxl/core/binding/dynamicobject.def"
#include "wxl/core/binding/corpse.def"
#include "wxl/core/binding/gameui.def"
#include "wxl/core/binding/maparea.def"
#include "wxl/core/binding/script.def"
#include "wxl/core/binding/netclient.def"

#ifdef WXL_BINDING_FIELD_DEFAULTED
    #undef WXL_BINDING_FIELD
    #undef WXL_BINDING_FIELD_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA
    #undef WXL_BINDING_FIELD_VIA_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA_INDEX
    #undef WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_AT_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA_AT
    #undef WXL_BINDING_FIELD_VIA_AT_DEFAULTED
#endif
